generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum ConsumerLevel {
  NO_ACCESS
  LOW_ACCESS
  MID_ACCESS
  HIGH_ACCESS
}

enum ProducerLevel {
  NO_ACCESS
  LOW_ACCESS
  MID_ACCESS
  HIGH_ACCESS
}

// Models

model User {
  id String @id @unique @default(cuid())

  // Personal Data
  name     String
  username String @unique
  email    String @unique
  password String

  // Permissions
  writePrivilege ProducerLevel @default(NO_ACCESS)
  readPrivilege  ConsumerLevel @default(NO_ACCESS)

  // Work specific

  // Worker municipality
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  municipalityId String
  // Worker organisation
  organisation   Organization @relation(fields: [orgId], references: [id])
  orgId          String
  // Worker projects
  project        Project?     @relation(fields: [projectId], references: [id])
  projectId      String?
  // Documents created by user
  documents      Document[]

  // Meta
  registered DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("users")
}

model Document {
  id String @id @unique @default(cuid())

  // Document Data
  name    String
  content String
  version Int    @default(1)

  // Document attributions
  // Author data
  author    User    @relation(fields: [authorId], references: [id])
  authorId  String
  // Project data
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  // Meta
  createdAt DateTime  @default(now())
  updatedAt DateTime?

  @@map("documents")
}

model Municipality {
  id String @id @unique @default(cuid())

  // Municipality data
  name          String         @unique
  organisations Organization[]
  user          User[]

  // Meta
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("municipalities")
}

model Organization {
  id String @id @unique @default(cuid())

  name           String       @unique
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  municipalityId String

  projects Project[]
  users    User[]

  // Meta
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("organisations")
}

model Project {
  id String @id @unique @default(cuid())

  // Project data
  name         String       @unique
  organisation Organization @relation(fields: [orgId], references: [id])
  orgId        String

  // Project Content
  documents Document[]
  user      User[]

  // Minimum permission level to read and write
  minWritePrivilege ProducerLevel @default(HIGH_ACCESS)
  minReadPrivilege  ConsumerLevel @default(HIGH_ACCESS)

  // Meta
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("projects")
}
