generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions"]
    binaryTargets   = ["native", "debian-openssl-1.1.x", "linux-arm64-openssl-1.1.x"]
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    extensions = [ltree]
}

enum PrivilegeLevel {
    NO_ACCESS
    LOW_ACCESS
    MID_ACCESS
    HIGH_ACCESS
}

enum DocumentType {
    FILE
    FOLDER
}

// NOTE: Also defined in `../utils/roles.ts`. Don't forget to update it as well
enum UserRole {
    Developer
    Manager
    Administrator
}

enum UserType {
    DEFAULT // Default user type, can only see organization data
    SUPERUSER_MUNICIPALITY // Can see data from all organizations in the municipality
    SUPERUSER_GLOBAL // Can see data from all organizations in all municipalities
}

// Models
model User {
    id String @id @unique @default(cuid())

    // Personal Data
    name     String
    username String
    email    String
    password String
    userRole UserRole @default(Developer)
    userType UserType @default(DEFAULT)

    // Permissions
    writePrivilege PrivilegeLevel @default(LOW_ACCESS)
    readPrivilege  PrivilegeLevel @default(LOW_ACCESS)

    // Worker municipality
    organization   Organization @relation(fields: [organizationId], references: [id])
    organizationId String

    municipality   Municipality @relation(fields: [municipalityId], references: [id])
    municipalityId String

    projects Project[]

    // Documents created by user
    documents Document[]

    // Meta
    registered DateTime  @default(now())
    updatedAt  DateTime? @updatedAt
    deleted Boolean @default(false)

    // Tracking user tokens
    lastLoginTime DateTime @default(now())
    needsToBeLoggedOut Boolean @default(false)

    @@map("users")
}

model Document {
    id String @id @unique @default(cuid())

    // Document Data
    name    String
    content String @db.Text
    version Int    @default(1)

    // Document attributions
    // Author data
    author   User   @relation(fields: [authorId], references: [id])
    authorId String

    // Project data
    project   Project @relation(fields: [projectId], references: [id])
    projectId String

    // Path to document
    path Unsupported("ltree")

    // Meta
    createdAt    DateTime     @default(now())
    updatedAt    DateTime?
    documentType DocumentType @default(FILE)

    @@unique([projectId, path])
    @@map("documents")
}

model Project {
    id String @id @unique @default(cuid())

    // Project data
    name           String
    organization   Organization @relation(fields: [organizationId], references: [id])
    organizationId String

    // Project Content
    documents Document[]
    users     User[]

    // Minimum permission level to read and write
    minWritePrivilege PrivilegeLevel @default(LOW_ACCESS)
    minReadPrivilege  PrivilegeLevel @default(LOW_ACCESS)

    // Meta
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt

    @@unique([name, organizationId])
    @@map("projects")
}

model Organization {
    id String @id @unique @default(cuid())

    name String @unique
    description String @default("Organisation Description")

    municipality   Municipality @relation(fields: [municipalityId], references: [id])
    municipalityId String

    projects Project[]
    users    User[]

    verified Boolean @default(false)

    // Meta
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt

    @@map("organisations")
}

model Municipality {
    id String @id @unique @default(cuid())

    // Municipality data
    name          String         @unique
    organizations Organization[]

    // Meta
    createdAt DateTime  @default(now())
    updatedAt DateTime? @updatedAt
    User      User[]

    @@map("municipalities")
}
