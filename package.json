    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.29.0",
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/eden": "^1.1.2",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/swagger": "^1.1.0",
    "@kobalte/core": "^0.13.4",
    "@lezer/highlight": "^1.2.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "5.17.0",
    "@solid-primitives/i18n": "^2.1.1",
    "@solidjs/router": "^0.14.1",
    "elysia": "1.1.4",
    "mapbox-gl": "^3.5.2",
    "maplibre-gl": "^4.5.0",
    "ncrypt-js": "^2.1.1",
    "or": "^0.2.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.17.0",
    "solid-codemirror": "^2.3.1",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.8.19",
    "solid-map-gl": "^1.11.3",
