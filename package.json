{
  "name": "sagittarius-v2",
  "version": "1.0.44",
  "type": "module",
  "scripts": {
    "start": "vite client",
    "dev": "vite client --port 4000",
    "build": "vite build client --outDir ../dist",
    "serve": "bun run --watch server/index.ts",
    "format": "bunx prettier client/ --write && bunx prettier server/ --write",
    "docker": "docker compose down && docker compose up --build",
    "db": "docker compose up db db-setup"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.1",
