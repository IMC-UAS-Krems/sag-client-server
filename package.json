    "sweetalert2": "^11.12.3",
    "vite": "^5.3.5",
    "vite-plugin-solid": "^2.10.2",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@ts-safeql/eslint-plugin": "^3.3.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.14.12",
    "autoprefixer": "^10.4.19",
    "bun-types": "^1.1.21",
